{
  "openapi": "3.0.0",
  "info": {
    "title": "ptxedgeworkers.dataspace.ptx.org",
    "version": "v1alpha1"
  },
  "paths": {},
  "components": {
    "schemas": {
      "PEW": {
        "type": "object",
        "description": "PTX Edge Worker description",
        "required": [
          "spec"
        ],
        "properties": {
          "spec": {
            "type": "object",
            "description": "Specification of PTX Edge Worker",
            "required": [
              "data",
              "worker"
            ],
            "properties": {
              "service": {
                "type": "object",
                "description": "Initiate worker as a service, not a single-executed task",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "Enable service creation",
                    "default": false
                  },
                  "interfaces": {
                    "type": "array",
                    "description": "Exposed worker interfaces",
                    "items": {
                      "type": "object",
                      "required": [
                        "port"
                      ],
                      "properties": {
                        "port": {
                          "type": "integer",
                          "description": "Service port",
                          "minimum": 1,
                          "maximum": 65535,
                          "example": 8080
                        },
                        "public": {
                          "type": "boolean",
                          "description": "Enable out-of-cluster access",
                          "default": false
                        },
                        "secured": {
                          "type": "boolean",
                          "description": "Apply the same security measures as of the REST-API, e.g., authentication",
                          "default": false
                        }
                      }
                    }
                  }
                }
              },
              "data": {
                "type": "object",
                "description": "Data collection parameters",
                "required": [
                  "src"
                ],
                "properties": {
                  "src": {
                    "type": "object",
                    "description": "Data source location",
                    "required": [
                      "path"
                    ],
                    "properties": {
                      "scheme": {
                        "type": "string",
                        "description": "Data collection scheme",
                        "enum": [
                          "file",
                          "dir",
                          "http",
                          "https",
                          "ptx"
                        ],
                        "example": "https"
                      },
                      "path": {
                        "type": "string",
                        "description": "Data resource location",
                        "pattern": "^([^:/]+://)?([^:/]+(:[0-9]{1,5})?)?(/.+)$",
                        "example": "https://my.api.localhost:8080/data/example.csv"
                      },
                      "auth": {
                        "type": "object",
                        "description": "Authentication parameters for remote data collection",
                        "required": [
                          "method",
                          "user",
                          "secret"
                        ],
                        "properties": {
                          "method": {
                            "type": "string",
                            "description": "Used authentication method",
                            "enum": [
                              "basic",
                              "digest",
                              "bearer"
                            ],
                            "example": "basic"
                          },
                          "user": {
                            "type": "string",
                            "description": "User identification",
                            "minLength": 1,
                            "example": "admin"
                          },
                          "secret": {
                            "type": "string",
                            "description": "Secret token or password",
                            "minLength": 1,
                            "format": "password",
                            "example": "myPasswd!007"
                          }
                        }
                      }
                    }
                  },
                  "dst": {
                    "type": "object",
                    "description": "Data destination location",
                    "properties": {
                      "scheme": {
                        "type": "string",
                        "description": "Data propagation scheme",
                        "enum": [
                          "local"
                        ],
                        "default": "local"
                      },
                      "path": {
                        "type": "string",
                        "description": "Data resource location",
                        "pattern": "^((/[a-zA-Z0-9-_]+)+)$",
                        "default": "/var/cache/data"
                      }
                    }
                  }
                }
              },
              "worker": {
                "type": "object",
                "description": "Worker environment parameters",
                "required": [
                  "location"
                ],
                "properties": {
                  "location": {
                    "type": "object",
                    "description": "Worker image location",
                    "required": [
                      "image"
                    ],
                    "properties": {
                      "protocol": {
                        "type": "string",
                        "description": "Image pull approach",
                        "enum": [
                          "docker",
                          "secret",
                          "ptx"
                        ],
                        "default": "docker"
                      },
                      "image": {
                        "type": "string",
                        "description": "Image resource location",
                        "pattern": "^([^:/]+://)?([^:/]+(:[0-9]{1,5})?/)?([^:]+):([^:/]+)$",
                        "example": "busybox:latest"
                      },
                      "cred": {
                        "type": "object",
                        "description": "Credentials for remote image collection",
                        "required": [
                          "user",
                          "secret"
                        ],
                        "properties": {
                          "server": {
                            "type": "string",
                            "description": "Image server prefix",
                            "pattern": "^([^:/]+)(://)([^:/]+(:[0-9]{1,5})?)((/[^/]+)*)/$",
                            "default": "https://index.docker.io/v1/"
                          },
                          "user": {
                            "type": "string",
                            "description": "Image registry user",
                            "minLength": 1,
                            "example": "admin"
                          },
                          "secret": {
                            "type": "string",
                            "description": "Server password or token",
                            "minLength": 1,
                            "format": "password",
                            "example": "myPasswd!007"
                          },
                          "insecure": {
                            "type": "boolean",
                            "description": "Disable verification of image server's TLS certificate",
                            "default": false
                          }
                        }
                      }
                    }
                  },
                  "cached": {
                    "type": "boolean",
                    "description": "Worker cached in local registry, otherwise pull secret is used with auth",
                    "default": true
                  },
                  "name": {
                    "type": "string",
                    "description": "Cached image name, otherwise autogenerated from source image",
                    "pattern": "^([^:]+):([^:/]+)$",
                    "example": "myworker:latest"
                  },
                  "command": {
                    "type": "array",
                    "description": "Override image start command",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "description": "command & args"
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Worker image configuration parameters",
                    "properties": {
                      "file": {
                        "type": "object",
                        "description": "Configuration file",
                        "required": [
                          "path",
                          "data"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "description": "Mount path of configuration file",
                            "pattern": "^((/[a-zA-Z0-9-_\\.]+)+)$",
                            "example": "/var/cache/worker/cfg.ini"
                          },
                          "data": {
                            "type": "string",
                            "description": "Configuration data"
                          }
                        }
                      },
                      "env": {
                        "type": "array",
                        "description": "Environment variables",
                        "items": {
                          "type": "object",
                          "description": "Key-value pairs",
                          "required": [
                            "key",
                            "value"
                          ],
                          "properties": {
                            "key": {
                              "type": "string",
                              "description": "Variable name",
                              "minLength": 1,
                              "example": "MY_CFG_ENVVAR"
                            },
                            "value": {
                              "type": "string",
                              "description": "Value string",
                              "example": "42"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "dataspace": {
                "type": "object",
                "description": "PTX dataspace-related configuration",
                "required": [
                  "exchange"
                ],
                "properties": {
                  "exchange": {
                    "type": "object",
                    "description": "Attributes of data exchange via PTX dataspace",
                    "required": [
                      "contract"
                    ],
                    "properties": {
                      "contract": {
                        "type": "string",
                        "description": "Dataspace contract ID",
                        "minLength": 1,
                        "pattern": "^[0-9a-fA-F]+$",
                        "example": "66db1a6dc29e3ba863a85e0f"
                      },
                      "provider": {
                        "type": "object",
                        "description": "Data provider configuration",
                        "required": [
                          "offer"
                        ],
                        "properties": {
                          "offer": {
                            "type": "string",
                            "description": "Data offering ID",
                            "minLength": 1,
                            "pattern": "^[0-9a-fA-F]+$",
                            "example": "66d187f4ee71f9f096bae8ca"
                          },
                          "resource": {
                            "type": "string",
                            "description": "Data resource ID",
                            "minLength": 1,
                            "pattern": "^[0-9a-fA-F]+$",
                            "example": "66d1889cee71f9f096bae98b"
                          }
                        }
                      },
                      "consumer": {
                        "type": "object",
                        "description": "Data consumer configuration",
                        "required": [
                          "offer"
                        ],
                        "properties": {
                          "offer": {
                            "type": "string",
                            "description": "Service offering ID",
                            "minLength": 1,
                            "pattern": "^[0-9a-fA-F]+$",
                            "example": "66d18b79ee71f9f096baecb1"
                          },
                          "resource": {
                            "type": "string",
                            "description": "Software resource ID",
                            "minLength": 1,
                            "pattern": "^[0-9a-fA-F]+$",
                            "example": "66d18bf6ee71f9f096baed58"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "status": {
            "type": "object",
            "description": "Runtime information",
            "x-kubernetes-preserve-unknown-fields": true,
            "properties": {
              "state": {
                "type": "string",
                "description": "Task state from [created | running | finished]"
              }
            }
          }
        },
        "x-database-model": {
          "group": "dataspace.ptx.org",
          "version": "v1alpha1",
          "kind": "PtxEdgeWorker",
          "singular": "ptxedgeworker",
          "plural": "ptxedgeworkers"
        }
      }
    }
  }
}