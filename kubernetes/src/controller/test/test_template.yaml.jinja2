apiVersion: apps/v1
kind: Deployment
metadata:
  {# name: autofilled #}
  {# namespace: autofilled #}
  labels:
    tier: worker
    {# autofilled #}
spec:
  replicas: 1
  selector:
    matchLabels:
      tier: worker
  template:
    metadata:
      labels:
        tier: worker
    spec:
      terminationGracePeriodSeconds: 10
      initContainers:
        - name: builder
          image: {{ cfg.registry.path ~ "/" if cfg.registry and cfg.registry.path }}{{ cfg.builder.image }}
          imagePullPolicy: IfNotPresent
          command: [ "python3", "-m", "app", "-v" ]
          volumeMounts:
            - name: registry-ca
              mountPath: /usr/share/ca-certificates/ptx-edge
              readOnly: true
            {% if data.dst and (data.dst.method | upper) == "LOCAL"  %}
            - name: data-dir
              mountPath: /var/cache/data/
              readOnly: false
            {% endif %}
          env:
            # PDC configuration
            - name: BUILD_PDC_HOST
              value: {{ cfg.pdc.host if cfg.pdc.host }}
            - name: BUILD_PDC_PORT
              value: "3000"
            - name: BUILD_PDC_KEY_SERVICE
              valueFrom:
                secretKeyRef:
                  name: {{ cfg.pdc.secret }}
                  key: SERVICE_KEY
            - name: BUILD_PDC_KEY_SECRET
              valueFrom:
                secretKeyRef:
                  name: {{ cfg.pdc.secret }}
                  key: SECRET_KEY
            # Basic builder configuration
            - name: BUILD_CONNECTION_TIMEOUT
              value: "600"
            - name: BUILD_DATA_DST
              value: "/var/cache/data/"
            # Datasource configuration
            - name: BUILD_DATA_METHOD
              value: {{ data.src.method }}
            {% if data.src.method != "SKIP" %}
            - name: BUILD_DATA_SRC
              value: {{ data.src.path if data.src.path is not none }}
            {% endif %}
            # Direct datasource configuration
            {% if data.src.auth %}
            - name: BUILD_DATA_AUTH_SCHEME
              value: "{{ data.src.auth.scheme }}"
            - name: BUILD_DATA_AUTH_USER
              value: "{{ data.src.auth.user }}"
            - name: BUILD_DATA_AUTH_SECRET
              value: "{{ data.src.auth.secret.get_secret_value() }}"
            - name: BUILD_DATA_AUTH_INSECURE
              value: "{{ data.src.auth.insecure | lower }}"
            {% endif %}
            # PTX configuration
            {% if dataspace.exchange.data %}
            - name: BUILD_PTX_DATA_EXCHANGE_CONTRACT
              value: {{ "https://contract.visionstrust.com/contracts/" ~ dataspace.exchange.data.contract }}
            - name: BUILD_PTX_DATA_EXCHANGE_DATA_OFFER
              value: {{ "https://api.visionstrust.com/v1/catalog/serviceofferings/" ~ dataspace.exchange.data.provider.offer }}
            {% if dataspace.exchange.data.provider.resource %}
            - name: BUILD_PTX_DATA_EXCHANGE_DATA_RESOURCE
              value: {{ "https://api.visionstrust.com/v1/catalog/dataresources/" ~ dataspace.exchange.data.provider.resource }}
            {% endif %}
            - name: BUILD_PTX_DATA_EXCHANGE_SERVICE_OFFER
              value: {{ "https://api.visionstrust.com/v1/catalog/serviceofferings/" ~ dataspace.exchange.data.consumer.offer }}
            {% if dataspace.exchange.data.consumer.resource %}
            - name: BUILD_PTX_DATA_EXCHANGE_SERVICE_RESOURCE
              value: {{ "https://api.visionstrust.com/v1/catalog/softwareresources/" ~ dataspace.exchange.data.consumer.resource }}
            {% endif %}
            {% endif %}
            {% if dataspace.exchange.worker %}
            - name: BUILD_PTX_WORKER_EXCHANGE_CONTRACT
              value: {{ "https://contract.visionstrust.com/contracts/" ~ dataspace.exchange.worker.contract }}
            - name: BUILD_PTX_WORKER_EXCHANGE_DATA_OFFER
              value: {{ "https://api.visionstrust.com/v1/catalog/serviceofferings/" ~ dataspace.exchange.worker.provider.offer }}
            {% if dataspace.exchange.worker.provider.resource %}
            - name: BUILD_PTX_WORKER_EXCHANGE_DATA_RESOURCE
              value: {{ "https://api.visionstrust.com/v1/catalog/dataresources/" ~ dataspace.exchange.worker.provider.resource }}
            {% endif %}
            - name: BUILD_PTX_WORKER_EXCHANGE_SERVICE_OFFER
              value: {{ "https://api.visionstrust.com/v1/catalog/serviceofferings/" ~ dataspace.exchange.worker.consumer.offer }}
            {% if dataspace.exchange.worker.consumer.resource %}
            - name: BUILD_PTX_WORKER_EXCHANGE_SERVICE_RESOURCE
              value: {{ "https://api.visionstrust.com/v1/catalog/softwareresources/" ~ dataspace.exchange.worker.consumer.resource }}
            {% endif %}
            {% endif %}
            # Worker configuration
            - name: BUILD_WORKER_METHOD
              value: {{ worker.location.method }}
            {% if worker.location.method != "SKIP" %}
            - name: BUILD_WORKER_SRC
              value: {{ worker.location.image if worker.location.image is not none and worker.cached is true }}
            {% endif %}
            {% if worker.location.cred %}
            - name: BUILD_WORKER_AUTH_SERVER
              value: "{{ worker.location.cred.server }}"
            - name: BUILD_WORKER_AUTH_USER
              value: "{{ worker.location.cred.user }}"
            - name: BUILD_WORKER_AUTH_SECRET
              value: "{{ worker.location.cred.secret.get_secret_value() }}"
            - name: BUILD_WORKER_AUTH_INSECURE
              value: "{{ worker.location.cred.insecure | lower }}"
            {% endif %}
            {% if worker.cached is true %}
            - name: BUILD_WORKER_DST
              value: {{ "worker/" ~ worker.name }}
            {% endif %}
          ports:
            - name: webhook-port
              containerPort: 9999
              protocol: TCP
      containers:
        - name: worker
          image: {% if worker.cached and worker.name -%}
                  {{ (cfg.registry.path ~ "/" if cfg.registry and cfg.registry.path) ~ "worker/" ~ worker.name }}
                  {% else -%}
                  {{ worker.location.image if worker.location.image}}
                  {% endif %}
          imagePullPolicy: IfNotPresent
          {% if worker.command is iterable %}
          command:
          {% for cmd in worker.command %}
            - "{{ cmd.model_dump() }}"
          {% endfor %}
          {% endif %}
          {% if worker.demands %}
          resources:
            requests:
              {% if worker.demands.cpu %}
              cpu: {{ ( 1000 * worker.demands.cpu ) | int ~ "m"}}
              {% endif %}
              {% if worker.demands.memory %}
              memory: {{ worker.demands.memory | int ~ "M"}}
              {% endif %}
          {% endif %}
          # Data destination configuration
          {% if data.dst and (data.dst.method | upper) == "LOCAL"  %}
          volumeMounts:
            - name: data-dir
              mountPath: {{ data.dst.path | default("/var/cache/data", true) }}
              readOnly: true
          {% endif %}
          {% if worker.config.env is iterable %}
          env:
          {% for envvar in worker.config.env %}
            - name: "{{ envvar.key }}"
              {% if envvar.value  %}
              value: "{{ envvar.value }}"
              {% endif %}
          {% endfor %}
          {% endif %}
          {% if service.interfaces is iterable %}
          ports:
          {% for interface in service.interfaces %}
            - name: {{ "port-" ~ interface.port }}
              containerPort: {{ interface.port | int }}
              protocol: TCP
          {% endfor %}
          {% endif %}
      schedulerName: {{ cfg.scheduler.name if dataspace.privacy.required is true else "default" }}
      {% if dataspace.privacy.zones %}
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              {% for zone in dataspace.privacy.zones %}
              - matchExpressions:
                  - key: {{ "privacy-zone.dataspace.ptx.org/" ~ zone.model_dump() }}
                    operator: In
                    values:
                      - "true"
              {% endfor %}
      {% endif %}
      volumes:
        - name: registry-ca
          configMap:
            name: registry-root-ca.crt
            items:
              - key: ca.crt
                path: registry_CA.crt
        {% if data.dst and (data.dst.method | upper) == "LOCAL"  %}
        - name: data-dir
          emptyDir:
            sizeLimit: {{ data.src.size ~ "Mi" }}
        {% endif %}
