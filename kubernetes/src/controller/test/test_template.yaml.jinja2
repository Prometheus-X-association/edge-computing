{#kind: Service#}
{#metadata:#}
{#  name: ${DP0}#}
{#  namespace: ${PTX}#}
{#  labels:#}
{#    app.kubernetes.io/name: ${DP0}#}
{#    env: ${ENV}#}
{#    tier: worker#}
{#spec:#}
{#  selector:#}
{#    app.kubernetes.io/name: ${DP0}#}
{#    env: ${ENV}#}
{#    tier: worker#}
{#  type: ClusterIP#}
{#  ports:#}
{#    - name: port-mlflow#}
{#      port: 5000#}
{#      targetPort: port-mlflow#}
{#    - name: port-api#}
{#      port: 8000#}
{#      targetPort: port-api#}
{#---#}
{#apiVersion: v1#}
{#kind: Service#}
{#metadata:#}
{#  name: ${BUILDER}-${DP0}#}
