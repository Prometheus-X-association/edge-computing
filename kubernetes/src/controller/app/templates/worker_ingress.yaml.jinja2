{% set public = spec.service.interfaces | selectattr("public") | first
                if spec.service and spec.service.interfaces is iterable %}
{% set middlewares = [] %}
{% if public %}
  {% if public.restricted %}
    {% set middlewares = middlewares + [namespace ~ "-api-basic-auth@kubernetescrd"] %}
  {% endif %}
  {% if public.stripped %}
    {% set middlewares = middlewares + [namespace ~ "-" ~ name ~ "-stripprefix@kubernetescrd"] %}
  {% endif %}
{% endif %}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/name: {{ name }}
    app.kubernetes.io/component: worker
    app.kubernetes.io/part-of: {{ name }}
    app.kubernetes.io/managed-by: {{ cfg.controller.manager }}
    {# autofilled #}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: {{ "websecure" if public and public.secured else "web" }}
    traefik.ingress.kubernetes.io/router.middlewares: {{ middlewares | join(",") }}
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: {{ "/worker/" ~ name }}
            pathType: Prefix
            backend:
              service:
                name: {{ name }}
                port:
                  number: {{ public.port | int if public }}
