{% set public_interface = spec.service.interfaces | selectattr('public') | first %}
{% set middlewares = [namespace ~ '-' ~ name ~ '-stripprefix@kubernetescrd'] %}
{% if public_interface.secured %}
  {% set middlewares = [namespace ~ '-api-basic-auth@kubernetescrd'] + middlewares %}
{% endif %}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    tier: worker
    {# autofilled #}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.middlewares: {{ middlewares | join(',') }}
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: {{ '/worker/' ~ name }}
            pathType: Prefix
            backend:
              service:
                name: {{ name }}
                port:
                  name: {{ 'port-' ~ public_interface.port }}
