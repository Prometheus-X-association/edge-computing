{% set public = spec.service.interfaces | selectattr('public') | first
                          if spec.service and spec.service.interfaces is iterable %}
{% set middlewares = [namespace ~ '-' ~ name ~ '-stripprefix@kubernetescrd'] %}
{% if public and public.restricted %}
  {% set middlewares = [namespace ~ '-api-basic-auth@kubernetescrd'] + middlewares %}
{% endif %}
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    tier: worker
    {# autofilled #}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: {{ "websecure" if public and public.secured else "web" }}
    traefik.ingress.kubernetes.io/router.middlewares: {{ middlewares | join(',') }}
spec:
  ingressClassName: traefik
  rules:
    - http:
        paths:
          - path: {{ '/worker/' ~ name }}
            pathType: Prefix
            backend:
              service:
                name: {{ name }}
                port:
                  number: {{ public.port | int if public }}
