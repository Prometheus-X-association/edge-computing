apiVersion: v1
kind: Service
metadata:
  name: {{ cfg.builder.name ~ "-" ~ name }}
  namespace: {{ namespace }}
  labels:
    tier: worker
    {# autofilled #}
spec:
  selector:
    app.kubernetes.io/name: {{ name }}
    tier: worker
  type: ClusterIP
  ports:
    - name: webhook-port
      protocol: TCP
      port: {{ cfg.builder.port | int }}
      targetPort: {{ cfg.builder.port | int }}
  publishNotReadyAddresses: true