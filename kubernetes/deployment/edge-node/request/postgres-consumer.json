{
  "spec": {
    "name": "${_WKR}",
    "service": {
      "enabled": true,
      "interfaces": [
        {
          "port": 5432,
          "public": false
        }
      ]
    },
    "data": {
      "src": {
        "method": "SKIP"
      }
    },
    "worker": {
      "src": {
        "method": "SKIP",
        "image": "postgres:17-alpine"
      },
      "config": {
        "env": [
          {
            "key": "POSTGRES_DB",
            "value": "dva"
          },
          {
            "key": "POSTGRES_PASSWORD",
            "value": "postgres"
          }
        ]
      },
      "demands": {
        "cpu": 0.5,
        "memory": 200
      }
    },
    "dataspace": {
      "privacy": {
        "required": true,
        "zones": [
          {
            "name": "${DEF_ZONE}",
            "preferred": true
          }
        ]
      }
    }
  }
}