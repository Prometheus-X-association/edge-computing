{
  "spec": {
    "name": "${_WKR}",
    "service": {
      "enabled": true,
      "interfaces": [
        {
          "port": 8000,
          "public": false
        }
      ]
    },
    "data": {
      "src": {
        "method": "SKIP"
      }
    },
    "worker": {
      "src": {
        "method": "SKIP",
        "image": "${REGISTRY}:${REGISTRY_PORT}/${_WKR}:latest"
      },
      "config": {
        "env": [
          {
            "key": "DVA_VC_MANAGER_DB_URL",
            "value": "postgresql://${DVA_POSTGRES_CRED}@postgres-provider.${PTX}.svc.cluster.local:5432/dva"
          }
        ]
      },
      "demands": {
        "cpu": 0.5,
        "memory": 200
      }
    },
    "dataspace": {
      "privacy": {
        "required": true,
        "zones": [
          {
            "name": "${DEF_ZONE}",
            "preferred": true
          }
        ]
      }
    }
  }
}