{
  "spec": {
    "name": "${_WKR}",
    "service": {
      "enabled": true,
      "interfaces": [
        {
          "port": 80,
          "public": false
        }
      ]
    },
    "data": {
      "src": {
        "method": "SKIP"
      }
    },
    "worker": {
      "src": {
        "method": "SKIP",
        "image": "${REGISTRY}:${REGISTRY_PORT}/${_WKR}:latest"
      },
      "config": {
        "env": [
          {
            "key": "DVA_DASHBOARD_BASE_URL",
            "value": "/worker/${_WKR}/"
          },
          {
            "key": "DVA_API_URL",
            "value": "http://dva-api-consumer:9090"
          },
          {
            "key": "DVA_VLA_MANAGER_URL",
            "value": "http://vlamanager-backend:8000"
          }
        ]
      },
      "demands": {
        "cpu": 0.5,
        "memory": 200
      }
    },
    "dataspace": {
      "privacy": {
        "required": true,
        "zones": [
          {
            "name": "${DEF_ZONE}",
            "preferred": true
          }
        ]
      }
    }
  }
}