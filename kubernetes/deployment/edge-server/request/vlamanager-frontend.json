{
  "spec": {
    "name": "${_WKR}",
    "service": {
      "enabled": true,
      "interfaces": [
        {
          "port": 80,
          "public": true,
          "restricted": false,
          "stripped": false
        }
      ]
    },
    "data": {
      "src": {
        "method": "SKIP"
      }
    },
    "worker": {
      "src": {
        "method": "SKIP",
        "image": "${REGISTRY}:${REGISTRY_PORT}/${_WKR}:latest"
      },
      "config": {
        "env": [
          {
            "key": "BASE_PATH",
            "value": "/worker/${_WKR}/"
          },
          {
            "key": "VLA_MANAGER_BACKEND_URL",
            "value": "http://vlamanager-backend.${PTX}.svc.cluster.local:8000"
          }
        ]
      },
      "demands": {
        "cpu": 0.5,
        "memory": 100
      }
    },
    "dataspace": {
      "privacy": {
        "required": true,
        "zones": [
          {
            "name": "${DEF_ZONE}",
            "preferred": true
          }
        ]
      }
    }
  }
}