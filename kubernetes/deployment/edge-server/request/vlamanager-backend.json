{
  "spec": {
    "name": "${_WKR}",
    "service": {
      "enabled": true,
      "interfaces": [
        {
          "port": 8000,
          "public": false
        }
      ]
    },
    "data": {
      "src": {
        "method": "SKIP"
      }
    },
    "worker": {
      "src": {
        "method": "SKIP",
        "image": "${REGISTRY}:${REGISTRY_PORT}/${_WKR}:latest"
      },
      "config": {
        "env": [
          {
            "key": "VLA_MANAGER_DB_URL",
            "value": "postgresql://postgres:postgres@postgres-vlamanager.${PTX}.svc.cluster.local:5432/dva"
          },
          {
            "key": "VLA_MANAGER_API_PROCESSING_URL",
            "value": "http://dva-processing-vlamanager.${PTX}.svc.cluster.local:5000"
          },
          {
            "key": "VLA_MANAGER_AI_PROVIDER",
            "value": "${VLA_MANAGER_AI_PROVIDER}"
          },
          {
            "key": "VLA_MANAGER_AI_URL",
            "value": "${VLA_MANAGER_AI_URL}"
          },
          {
            "key": "VLA_MANAGER_AI_API_KEY",
            "value": "${VLA_MANAGER_AI_API_KEY}"
          },
          {
            "key": "VLA_MANAGER_AI_MODEL",
            "value": "${VLA_MANAGER_AI_MODEL}"
          },
          {
            "key": "VLA_MANAGER_AI_TIMEOUT_SECONDS",
            "value": "${VLA_MANAGER_AI_TIMEOUT_SECONDS}"
          }
        ]
      },
      "demands": {
        "cpu": 0.5,
        "memory": 100
      }
    },
    "dataspace": {
      "privacy": {
        "required": true,
        "zones": [
          {
            "name": "${DEF_ZONE}",
            "preferred": true
          }
        ]
      }
    }
  }
}